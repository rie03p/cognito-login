# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cognito Configuration
DOMAIN_PREFIX=your-unique-domain-prefix

# Callback URLs (comma-separated for multiple URLs)
CALLBACK_URLS=http://localhost:5173/callback,https://yourdomain.com/callback

# Logout URLs (comma-separated for multiple URLs)
LOGOUT_URLS=http://localhost:5173,https://yourdomain.com
